# Copy this file to backend/.env and fill in DATABASE_URL (do not commit backend/.env).
#
# Supabase Dashboard → Project Settings → Database → Connection string → URI
# Choose "Transaction" pooler (port 6543) for the worker.
# Replace [YOUR-PASSWORD] with the database password from the same page.
# If the password has @ # % : / etc., paste the URI as-is — the worker encodes it automatically.
#
DATABASE_URL=postgresql://postgres.[project-ref]:[YOUR-PASSWORD]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true
#
# Alias also accepted:
# SUPABASE_DB_URL=postgresql://...

# Optional HTTP API (cmd/api) — protect with a shared secret
API_ADDR=:8080
API_KEY=generate-a-long-random-secret

# Worker behaviour
WORKER_RUN_ONCE=false
WORKER_SYNC_INTERVAL=5m
WORKER_CHECK_INTERVAL=15m
CHECK_CONCURRENCY=25
CHECK_TIMEOUT=12s
CHECK_FAILURE_THRESHOLD=2
# Comma-separated organization.status values to auto-monitor when website_url is set
MONITOR_STATUSES=listed,onboarding,under_review,verified,active

# Email (Resend) — site-down alerts, membership welcome, badge issued
# https://resend.com/api-keys — verify NOTIFY_FROM_EMAIL domain in Resend dashboard
RESEND_API_KEY=re_xxxxxxxx
NOTIFY_FROM_EMAIL=NGOreality <notifications@ngoreality.com>
# Optional BCC on every member email
NOTIFY_STAFF_EMAIL=ops@ngoreality.com

# Cloudflare Turnstile — server-side token verification for public forms
# https://dash.cloudflare.com → Turnstile → Add site → Secret key
TURNSTILE_SECRET_KEY=0x4AAAAAxxxxxxxxxxxxxxxxxxxxxx
