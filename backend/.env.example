# Copy this file to backend/.env and fill in DATABASE_URL (do not commit backend/.env).
#
# Supabase Dashboard → Project Settings → Database → Connection string → URI
# Choose "Transaction" pooler (port 6543) for the worker.
# Replace [YOUR-PASSWORD] with the database password from the same page.
# If the password has @ # % : / etc., paste the URI as-is — the worker encodes it automatically.
#
DATABASE_URL=postgresql://postgres.[project-ref]:[YOUR-PASSWORD]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true
#
# Alias also accepted:
# SUPABASE_DB_URL=postgresql://...

# Optional HTTP API (cmd/api) — protect with a shared secret
API_ADDR=:8080
API_KEY=generate-a-long-random-secret

# Worker behaviour
WORKER_RUN_ONCE=false
WORKER_SYNC_INTERVAL=5m
WORKER_CHECK_INTERVAL=15m
CHECK_CONCURRENCY=25
CHECK_TIMEOUT=12s
CHECK_FAILURE_THRESHOLD=2
# Comma-separated organization.status values to auto-monitor when website_url is set
MONITOR_STATUSES=listed,onboarding,under_review,verified,active

# Email (Resend) — site-down alerts, membership welcome, badge issued
# https://resend.com/api-keys — verify NOTIFY_FROM_EMAIL domain in Resend dashboard
RESEND_API_KEY=re_xxxxxxxx
NOTIFY_FROM_EMAIL=NGOreality <notifications@ngoreality.com>
# Optional BCC on every member email
NOTIFY_STAFF_EMAIL=ops@ngoreality.com

# Cloudflare Turnstile — server-side token verification for public forms
# https://dash.cloudflare.com → Turnstile → Add site → Secret key
TURNSTILE_SECRET_KEY=0x4AAAAAxxxxxxxxxxxxxxxxxxxxxx

# --- Organisation Workspace CRM (cmd/crm) ------------------------------------
# The CRM uses its OWN Postgres, separate from Supabase. Never point this at
# the Supabase project: beneficiary records must not share a cluster with the
# public registry.
# CRM_DATABASE_URL=postgres://user:pass@host:5432/railway

# REQUIRED. Supabase Dashboard -> Project Settings -> API -> JWT Settings.
# The service refuses to start without it, on purpose.
# SUPABASE_JWT_SECRET=

# Pins the expected token issuer.
# SUPABASE_PROJECT_REF=cpbilbskfbzqlynjhdvm

# Guards /v1/admin/* (tenant provisioning). Without it those routes are refused.
# CRM_ADMIN_API_KEY=

# Paymark (Worldline NZ) Online EFTPOS. PAYMARK_ENV defaults to sandbox; set
# "production" only when go-live is signed off. The key/secret come from the
# Paymark merchant portal (labelled Consumer Key / Consumer Secret) and are
# used to obtain bearer tokens for payment initiation. Backend only — never
# expose these to the frontend build.
# PAYMARK_ENV=sandbox
# PAYMARK_CONSUMER_KEY=
# PAYMARK_CONSUMER_SECRET=
# PAYMARK_MERCHANT_ID=      # from the merchant portal; required to START a payment

# Where Paymark POSTs the signed result, and where the payer returns to. The
# notification URL must be publicly reachable over https — if it is not, a
# payment succeeds at the bank and this service never hears about it, which
# looks identical to a customer who never paid.
# CRM_PUBLIC_BASE_URL=https://api.ngoreality.com
# CRM_SITE_BASE_URL=https://www.ngoreality.com

# CRM_API_ADDR=:8081        # Railway injects PORT; this overrides for local runs
# CRM_ALLOWED_ORIGINS=https://www.ngoreality.com,http://localhost:5173
# CRM_SKIP_TENANT_MIGRATIONS=false
