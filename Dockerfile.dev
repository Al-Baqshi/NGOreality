# Dev-only: Vite with hot reload (used by docker compose `web` service).
FROM node:22-alpine

WORKDIR /app

RUN corepack enable

COPY package.json yarn.lock package-lock.json* ./
RUN if [ -f yarn.lock ]; then yarn install --frozen-lockfile; else npm ci; fi

COPY . .

EXPOSE 5173

CMD ["sh", "-c", "if [ -f yarn.lock ]; then yarn dev --host 0.0.0.0; else npm run dev -- --host 0.0.0.0; fi"]
