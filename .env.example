# Supabase (https://supabase.com/dashboard → Project Settings → API)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Vercel: Project Settings → Environment Variables (Production + Preview)
# Use the same VITE_* names — Vite inlines them at build time.
#
# Staff CRM: create a user in Supabase Auth, then set staff access:
#   UPDATE profiles SET is_staff = true WHERE id = '<user-uuid>';
# Staff sign-in: /staff/login (username = staff email)
#
# Registry import (scripts/import-nz-charities.mjs — service role, never commit):
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# IMPORT_LIMIT=500   # optional cap for testing

# After deploy, add your Vercel URL(s) in Supabase:
# Authentication → URL Configuration → Site URL + Redirect URLs
# (e.g. https://your-app.vercel.app, https://ngoreality.com)
#
# Canonical site URL for SEO (canonical, sitemap, Open Graph)
# VITE_SITE_URL=https://www.ngoreality.com
