# Supabase (https://supabase.com/dashboard → Project Settings → API)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Vercel: Project Settings → Environment Variables (Production + Preview)
# Use the same VITE_* names — Vite inlines them at build time.
#
# Staff CRM access (manual setup in Supabase):
# 1. Authentication → Users → Add user (email + password), or use an existing auth user.
# 2. SQL Editor (replace email):
#    UPDATE public.profiles SET is_staff = true
#    WHERE id = (SELECT id FROM auth.users WHERE email = 'you@ngoreality.com');
# 3. Sign in at /staff/login — username is your full staff email (must include @).
# NGO portal: /ngo/signup — search the directory to claim a listed org, or register new.
#
# Registry import (scripts/import-nz-charities.mjs — service role, never commit):
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# IMPORT_LIMIT=500   # optional cap for testing

# Go backend (copy backend/.env.example → backend/.env)
# DATABASE_URL=postgresql://...  # Supabase Database → Connection string (URI)
#
# From repo root (local):
#   yarn dev          # frontend :5173
#   yarn api          # backend  :8080
#   yarn worker       # monitor worker
#   yarn dev:all      # frontend + api

# After deploy, add your Vercel URL(s) in Supabase:
# Authentication → URL Configuration → Site URL + Redirect URLs
# (e.g. https://your-app.vercel.app, https://ngoreality.com)
#
# Canonical site URL for SEO (canonical, sitemap, Open Graph)
# VITE_SITE_URL=https://www.ngoreality.com
#
# Stripe (optional — card checkout via edge function, when added)
# VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...
# Bank account details — NGO portal + CRM (optional until live)
# VITE_BANK_ACCOUNT_NAME=NGOreality Ltd
# VITE_BANK_NAME=Your Bank
# VITE_BANK_ACCOUNT_NUMBER=12-3456-7890123-00
# VITE_AIRWALLET_ENABLED=true

# Go monitor API — CRM "Send pending" for notification emails (optional)
# VITE_MONITOR_API_URL=http://localhost:8080
# VITE_MONITOR_API_KEY=same-as-backend-API_KEY

# Cloudflare Turnstile — spam protection for public forms
# https://dash.cloudflare.com → Turnstile → Add site
# Use "Managed" mode. Add your domain(s) to the site.
# VITE_TURNSTILE_SITE_KEY=0x4AAAAAxxxxxxxxxxxxxxxxxxxxxx

# Organisation Workspace — beneficiary & case management (ships dark)
# UI flag only; access is enforced by Postgres RLS in migration 027.
# Do not enable for a tenant until docs/PRIVACY_AND_RESIDENCY.md is signed off.
# VITE_WORKSPACE_ENABLED=true

# Cross-tenant isolation suite (yarn test:isolation) — DISPOSABLE project only.
# Never point these at production; the suite creates and deletes users and orgs.
# TEST_SUPABASE_URL=https://your-test-ref.supabase.co
# TEST_SUPABASE_ANON_KEY=
# TEST_SUPABASE_SERVICE_ROLE_KEY=

# Organisation Workspace CRM (Go service on Railway) — see docs/CRM_SAAS.md
# VITE_CRM_API_URL=https://crm-api-production-1b72.up.railway.app

# --- Central Baqshi identity (NGO users) --------------------------------------
# NGO users sign in at auth.baqshi.com; staff and the super admin stay on
# Supabase. Both defaults below are baked into src/lib/baqshiAuth.ts, so these
# only need setting to point at a different environment.
#
# The app key is PUBLISHABLE — it identifies NGOreality to the central service
# and scopes the token's audience. It is not a secret and ships in the bundle.
# VITE_BAQSHI_AUTH_URL=https://auth.baqshi.com
# VITE_BAQSHI_APP_KEY=pk_fbef4d16bce892ad19ed591012abbaec

# --- Email delivery (Resend) --------------------------------------------------
# The VERIFIED sending domain is contact.ngoreality.com, not the apex. Sending
# from an unverified domain is rejected by Resend, so this must match whatever
# is verified in the dashboard.
# NOTIFY_FROM_EMAIL=NGOreality <notifications@contact.ngoreality.com>
#
# Charities WILL reply to these emails. Without a reply-to they reply into a
# void. Set this to an inbox someone actually reads.
# NOTIFY_REPLY_TO=hello@ngoreality.com
#
# RESEND_API_KEY is set as a SUPABASE EDGE FUNCTION SECRET (not here), because
# delivery runs as the send-notifications function on a pg_cron schedule.
