# Supabase (https://supabase.com/dashboard → Project Settings → API)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Vercel: Project Settings → Environment Variables (Production + Preview)
# Use the same VITE_* names — Vite inlines them at build time.
#
# Staff CRM access (manual setup in Supabase):
# 1. Authentication → Users → Add user (email + password), or use an existing auth user.
# 2. SQL Editor (replace email):
#    UPDATE public.profiles SET is_staff = true
#    WHERE id = (SELECT id FROM auth.users WHERE email = 'you@ngoreality.com');
# 3. Sign in at /staff/login — username is your full staff email (must include @).
# NGO portal: /ngo/signup — search the directory to claim a listed org, or register new.
#
# Registry import (scripts/import-nz-charities.mjs — service role, never commit):
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# IMPORT_LIMIT=500   # optional cap for testing

# Go backend (copy backend/.env.example → backend/.env)
# DATABASE_URL=postgresql://...  # Supabase Database → Connection string (URI)
#
# From repo root (local):
#   yarn dev          # frontend :5173
#   yarn api          # backend  :8080
#   yarn worker       # monitor worker
#   yarn dev:all      # frontend + api

# After deploy, add your Vercel URL(s) in Supabase:
# Authentication → URL Configuration → Site URL + Redirect URLs
# (e.g. https://your-app.vercel.app, https://ngoreality.com)
#
# Canonical site URL for SEO (canonical, sitemap, Open Graph)
# VITE_SITE_URL=https://www.ngoreality.com
#
# Stripe (optional — card checkout via edge function, when added)
# VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...
# Bank account details for CRM copy (optional)
# VITE_BANK_ACCOUNT_NUMBER=12-3456-7890123-00
